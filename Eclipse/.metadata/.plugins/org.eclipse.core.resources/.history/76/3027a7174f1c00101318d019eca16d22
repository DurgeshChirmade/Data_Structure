package com.circular;

import java.io.BufferedReader;
import java.io.InputStreamReader;

public class circularSinglyLinkedList {

	BufferedReader br = new BufferedReader(new InputStreamReader(System.in));

	public Node create(int n) throws Exception {

		if (n <= 0) {
			return null;
		}

		// first node/head node
		Node first = new Node();

		System.out.print("Enter Data : ");
		int data = Integer.parseInt(br.readLine());

		first.setData(data);
		first.setNext(first);

		// last node/next node
		Node last = first;

		for (int i = 2; i <= n; i++) {
			System.out.print("Enter Data : ");
			data = Integer.parseInt(br.readLine());

			// temporary node
			Node temp = new Node();
			temp.setData(data);
			temp.setNext(null);
			last.setNext(temp);
			last = temp;
		}
		last.setNext(first); // make it circular
		return first;
	}

	public void display(Node first) {
		if (first == null) {
			System.out.println("Linked List is empty.");
			return;
		}

		Node temp = first;
		do {
			System.out.print(temp.getData());

			if (temp.getNext() != first) {
				System.out.println("=>");
			}
			temp = temp.getNext();
		} while (temp != first);

		System.out.println();
	}

	public Node eraseAll(Node first) {
		if (first == null) {
			return null;
		}

		Node temp = first.getNext(); // Move to the next node
		first.setNext(null); // Break the circular link

		while (temp != null && temp != first) { // Loop until all nodes are deleted
			Node delNode = temp;
			temp = temp.getNext();
			delNode.setNext(null); // Remove reference for garbage collection
		}
		return temp; // Return null since the list is deleted
	}


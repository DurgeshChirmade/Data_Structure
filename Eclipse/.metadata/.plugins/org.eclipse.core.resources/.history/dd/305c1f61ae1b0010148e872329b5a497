class PTAB {
	private char opr;
	private int priority;

	public PTAB(char opr, int priority) {
		this.opr = opr;
		this.priority = priority;
	}

	public char getOpr() {
		return opr;
	}

	public void setOpr(char opr) {
		this.opr = opr;
	}

	public int getPriority() {
		return priority;
	}

	public void setPriority(int priority) {
		this.priority = priority;
	}

}

class StackStatic {

	private int size;
	private char[] stack;
	private int top;

	public StackStatic(int size) {
		this.size = size;
		this.stack = new char[this.size];
		this.top = -1;
	}

	public boolean isFull() {
		if (top == size - 1) {
			return true;
		}

		return false;
	}

	public boolean isEmpty() {
		if (top == -1) {
			return true;
		}

		return false;
	}

	public void push(char value) {
		if (!isFull()) {
			stack[++top] = value;
		} else {
			System.out.println("\n Stack is overflow.....");
		}
	}

	public char peek() {
		if (!isEmpty()) {
			return stack[top];
		}
		System.out.println("\nStack is empty - cannot peek.");
		return '\0';
	}

	public char pop() {
		char value = '\0';
		if (!isEmpty()) {
			value = stack[top--];
			return value;
		}
		System.out.println("\nStack is underflow.....");
		;
		return value;
	}

}

public class InfixToPostfix {

	private static PTAB[] optab = { new PTAB('$', 3), new PTAB('^', 3), new PTAB('*', 2), new PTAB('/', 2),
			new PTAB('%', 2), new PTAB('+', 1), new PTAB('-', 1) };

	public static int getPriority(char op) {

		for (int i = 0; i < optab.length; i++) {
			if (op == optab[i].getOpr()) {
				return optab[i].getPriority();
			}
		}
		return -1;
	}
	
	public static boolean isOperant(char ch) {
		if(ch>='A' && ch<='Z')
			return true;
		else if(ch>='a' && ch<='z')
			return true;
		else if(ch>='0' && ch<='9') {
			return true;
		}
		else
			return false;
	}

	public static String postfix(String str) {

		StackStatic stk = new StackStatic(str.length());

		String postfix = "";

		for (int i = 0; i < str.length(); i++) {
			char ch = str.charAt(i);
			
			/*This is as per 6 rules logic-->use this*/
			if(isOperant(ch)) {
				postfix += ch;
			}
			else if(ch=='(') {
				// Rule 1: If char is '(', push to stack
				stk.push(ch);
			}
			else if(ch==')') {
				// Rule 2: Pop until '(' is found
				while(!stk.isEmpty() && stk.peek() != '(') {
					postfix += stk.pop();
				}
				if(!stk.isEmpty() && stk.peek()=='(') {
					stk.pop();
				}
				else {
					System.out.println("Error: Unmatched closing parenthesis.");
					return "Error";
				}
			}
			else {
				if (stk.isEmpty()) {
					// Rule 3: If stack is empty, push operator
					stk.push(ch);
				} else if (stk.peek() == '(') {
					// Rule 4: If top is '(', push operator
					stk.push(ch);
				} else if (getPriority(ch) > getPriority(stk.peek())) {
					// Rule 5: If current > top, push
					stk.push(ch);
				} else {
					// Rule 6: Pop until top has lower priority
					while (!stk.isEmpty() && stk.peek() != '(' && getPriority(ch) <= getPriority(stk.peek())) {
						postfix += stk.pop();
					}
					stk.push(ch);
				}
			}

